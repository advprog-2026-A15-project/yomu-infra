# .env.example — copy to .env and fill with real secrets
# .env.example — copy to .env and fill with real secrets
# Used by docker-compose (placed next to docker-compose.yml)

# Google OAuth (for Auth service)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated emails that should receive ADMIN role at login/register/refresh.
YOMU_ADMIN_EMAILS=christna.yosua@ui.ac.id,christian.yosua@ui.ac.id,tirta.rendy@ui.ac.id,nathanael.leander@ui.ac.id

# Optional: if you run the frontend with Vite, set the Vite-prefixed variable
# Create a separate frontend/.env or set this in your frontend dev env
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
